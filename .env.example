# Supabase proje ayarları → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Yalnızca sunucu tarafında kullanılır (personel daveti vb.). Asla istemciye sızmamalı.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# DavetMekanı entegrasyonu — iki tarafta AYNI değer olmalı.
# Üretmek için: openssl rand -hex 32
DAVETPRO_INTEGRATION_SECRET=

# DavetMekanı adresi (callback ve bağlama akışı için)
DAVETMEKANI_URL=http://localhost:3001

# Abonelik sayfasında gösterilen havale bilgileri. Boşsa sayfa yalnızca
# WhatsApp yönlendirmesi gösterir.
BILLING_IBAN=
BILLING_ACCOUNT_NAME=
BILLING_BANK=

# Yalnızca yerelde: `npm run db:apply -- 0049` canlı veritabanına migration uygular.
# supabase.com › Account › Access Tokens. Asla commit'leme / Vercel'e koyma.
SUPABASE_ACCESS_TOKEN=

# Erişim süresi hatırlatma e-postası (günlük cron: /api/cron/abonelik-hatirlatma)
# Vercel Cron bu değeri Authorization: Bearer olarak yollar. Üretmek için: openssl rand -hex 32
CRON_SECRET=
# resend.com API anahtarı ve doğrulanmış alan adından gönderen adres, örn. "DavetPro <bilgi@davetpro.com>"
RESEND_API_KEY=
MAIL_FROM=
