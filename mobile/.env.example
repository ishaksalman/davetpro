# Web uygulamasındaki NEXT_PUBLIC_* değerlerinin aynısı. Yalnızca anon anahtar:
# service_role anahtarı mobil uygulamaya ASLA konmaz.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web uygulamasının herkese açık adresi (davet / sıfırlama / sözleşme bağlantıları).
EXPO_PUBLIC_APP_URL=https://davetpro.example
# Yasal sayfalar (mağaza formları ve kayıt ekranı için zorunlu). Boşsa APP_URL + /gizlilik ve /kullanim-kosullari kullanılır.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
