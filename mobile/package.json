{
  "name": "davetpro-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@hookform/resolvers": "^5.9.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "date-fns": "^4.4.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/lib/(.*)$": "<rootDir>/../src/lib/$1",
      "^~/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|lucide-react-native|date-fns))"
    ]
  }
}
